[Unit]
Description=Threads ops scheduler+worker
After=network-online.target

[Service]
WorkingDirectory=/opt/tai/threads-automation
ExecStart=/usr/bin/env uv run python -m threads_ops run
Restart=always
RestartSec=10
# secrets: put them in threads-automation/.env (threads-automation) or an EnvironmentFile readable only by this user

User=tai

[Install]
WantedBy=multi-user.target
