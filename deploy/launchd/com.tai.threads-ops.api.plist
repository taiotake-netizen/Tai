<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 管理画面向けAPI（127.0.0.1:8787）
     Replace __REPO__ with the absolute path of this repository, then:
       cp com.tai.threads-ops.api.plist ~/Library/LaunchAgents/ && launchctl load -w ~/Library/LaunchAgents/com.tai.threads-ops.api.plist
     Secrets are read from the project's .env file, not from this plist. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tai.threads-ops.api</string>
  <key>WorkingDirectory</key><string>__REPO__/threads-automation</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>uv</string>
    <string>run</string>
    <string>python</string>
    <string>-m</string>
    <string>threads_ops</string>
    <string>api</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8787</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__REPO__/threads-automation/data/api.log</string>
  <key>StandardErrorPath</key><string>__REPO__/threads-automation/data/api.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
