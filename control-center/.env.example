# AI CONTROL CENTER — 環境変数の名前だけを記載。値は .env.local（Git管理外）に書くこと。

# セッション署名鍵（32文字以上、本番では必須）
CC_SESSION_SECRET=

# 実データ用ユーザー（JSON配列）。password_hash は `npm run hash-password` で作成
# 例: [{"username":"tai","password_hash":"scrypt$...$...","accounts":["main"],"role":"admin"}]
CC_USERS=

# 実データのThreads運用エンジン
THREADS_OPS_URL=http://127.0.0.1:8787
THREADS_OPS_API_TOKEN=

# デモ（ログイン画面に「デモで確認する」を表示。デモ用エンジンにだけ接続）
CC_DEMO_ENABLED=false
DEMO_THREADS_OPS_URL=http://127.0.0.1:8788
DEMO_THREADS_OPS_API_TOKEN=

# エンジンを別ホストに置く場合のみ（カンマ区切り）。既定は 127.0.0.1, localhost のみ許可
CC_ALLOWED_UPSTREAM_HOSTS=
