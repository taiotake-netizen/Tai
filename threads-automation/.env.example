# threads-automation (Threads運用エンジン) — 環境変数の名前だけを記載。値は .env に書き、Gitに入れないこと。

# production | development | demo | test
#   demo/test では PUBLISH_MODE は強制的に dry_run、LLM は mock になります
APP_ENV=development

# SQLite の保存先（省略時 data/threads_ops.db、demo は data/demo.db）
THREADS_OPS_DB=

# 管理画面（BFF）からのAPI呼び出し用の共有トークン。production では必須（32文字以上推奨）
THREADS_OPS_API_TOKEN=

# --- AI（運用中の文章生成・分析・レポート要約）
LLM_PROVIDER=openai          # openai | mock | none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low  # none|low|medium|high|xhigh。非対応なら自動で外して再送します。unset で送らない
OPENAI_TIMEOUT_S=60
AI_MAX_CONCURRENCY=1

# --- Threads
# dry_run: 実際には投稿しない（既定） / live: 本番投稿（管理画面の「本番投稿ON」も必要）
PUBLISH_MODE=dry_run
# アクセストークン。変数名は init-account --token-env で指定したものに合わせる
THREADS_ACCESS_TOKEN=
THREADS_API_BASE=https://graph.threads.net/v1.0

# --- ワーカー
WORKER_ID=worker-1
