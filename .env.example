# コピーして .env として保存し、必要なものだけ設定してください（.env はコミットしない）

# AI予測・検証レポートの仮説（Claude API）
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# 重要度8以上のイベントで、発表の前日（26〜2時間前）と直前（2時間〜10分前）にAI予測を自動作成
AUTO_AI_FORECAST=1

# XAUUSD 1分足の自動取得（Twelve Data、無料プランあり）。発表65分後に取得して自動検証
TWELVEDATA_API_KEY=

# 週間カレンダー（市場予想・前回値）を6時間ごとに取得
CALENDAR_FEED_ENABLED=0
